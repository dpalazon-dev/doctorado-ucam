+++ b/src/features/workflow/useWorkflow.ts
@@ -0,0 +1,569 @@
+import { useCallback, useEffect, useMemo, useRef, useState } from "react";
+import type { LibraryApi, WorkflowApi } from "../../shared/contracts/ports";
+import type {
+  AnswerResolution,
+  GateEvaluationDto,
+  JsonValue,
+  PaperDto,
+  PhaseAnswerDto,
+  PhaseCode,
+  PhaseDefinitionDto,
+  PhaseDto,
+} from "../../shared/contracts/generated/contracts";
+
+export type WorkflowDraft = {
+  answerText: string;
+  structuredValue: JsonValue | null;
+  resolution: AnswerResolution;
+  explanation: string;
+  revision: number;
+  baseline: PhaseAnswerDto | null;
+  editVersion: number;
+  savedEditVersion: number;
+  status: "empty" | "saved" | "dirty" | "saving" | "error" | "conflict" | "unknown";
+  error: string | null;
+  observed: PhaseAnswerDto | null;
+  conflictReviewed: boolean;
+};
+
+type PendingSave = {
+  kind: "save";
+  args: Parameters<WorkflowApi["savePhaseAnswer"]>[0];
+  key: string;
+  phaseCode: PhaseCode;
+  editVersion: number;
+};
+
+type PendingAction =
+  | { kind: "back"; args: Parameters<WorkflowApi["goBackToPhase"]>[0]; target: PhaseCode }
+  | { kind: "touch"; args: Parameters<WorkflowApi["touchPhase"]>[0]; target: PhaseCode }
+  | { kind: "advance"; args: Parameters<WorkflowApi["advancePhase"]>[0] };
+
+type PaperSession = {
+  drafts: Map<string, WorkflowDraft>;
+  busy: boolean;
+  pending: PendingSave | null;
+  pendingAction: PendingAction | null;
+  refreshRequired: boolean;
+  refreshVersion: number;
+  listeners: Set<(confirmed: boolean, source: symbol) => void>;
+  editSequences: Map<string, number>;
+};
+
+export type WorkflowSession = { papers: Map<string, PaperSession> };
+
+export function createWorkflowSession(): WorkflowSession {
+  return { papers: new Map() };
+}
+
+function paperSession(session: WorkflowSession, paperId: string): PaperSession {
+  let current = session.papers.get(paperId);
+  if (!current) {
+    current = { drafts: new Map(), busy: false, pending: null, pendingAction: null, refreshRequired: false, refreshVersion: 0, listeners: new Set(), editSequences: new Map() };
+    session.papers.set(paperId, current);
+  }
+  return current;
+}
+
+function draftId(phaseCode: PhaseCode, questionKey: string) {
+  return `${phaseCode}:${questionKey}`;
+}
+
+function fromAnswer(answer: PhaseAnswerDto | undefined, editVersion = 0): WorkflowDraft {
+  return {
+    answerText: answer?.answerText ?? "",
+    structuredValue: answer?.structuredValue ?? null,
+    resolution: answer?.resolution ?? "PENDING",
+    explanation: answer?.explanation ?? "",
+    revision: answer?.revision ?? 0,
+    baseline: answer ?? null,
+    editVersion,
+    savedEditVersion: editVersion,
+    status: answer ? "saved" : "empty",
+    error: null,
+    observed: null,
+    conflictReviewed: false,
+  };
+}
+
+type HookOptions = {
+  api: WorkflowApi;
+  libraryApi: Pick<LibraryApi, "getPaper">;
+  paperId: string;
+  session: WorkflowSession;
+  writable: boolean;
+};
+
+export function useWorkflow({ api, libraryApi, paperId, session, writable }: HookOptions) {
+  const [paper, setPaper] = useState<PaperDto | null>(null);
+  const [phaseCode, setPhaseCode] = useState<PhaseCode | null>(null);
+  const [phase, setPhase] = useState<PhaseDto | null>(null);
+  const [activePhase, setActivePhase] = useState<PhaseDto | null>(null);
+  const [answers, setAnswers] = useState<PhaseAnswerDto[]>([]);
+  const [definition, setDefinition] = useState<PhaseDefinitionDto | null>(null);
+  const [gate, setGate] = useState<GateEvaluationDto | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState<string | null>(null);
+  const [message, setMessage] = useState<string | null>(null);
+  const [gateRejected, setGateRejected] = useState(false);
+  const [changed, setChanged] = useState(0);
+  const generation = useRef(0);
+  const contentGeneration = useRef(0);
+  const mounted = useRef(true);
+  const consumerId = useRef(Symbol("workflow-consumer"));
+  const paperRef = useRef<PaperDto | null>(null);
+  const state = paperSession(session, paperId);
+  const activePaper = paper?.id === paperId ? paper : null;
+  const selectedPhase = phaseCode;
+  const selectedPhaseRef = useRef<PhaseCode | null>(null);
+  selectedPhaseRef.current = selectedPhase;
+
+  const bump = useCallback((confirmed = false) => {
+    setChanged((value) => value + 1);
+    for (const listener of state.listeners) listener(confirmed, consumerId.current);
+  }, [state]);
+
+  const loadPaper = useCallback(async (): Promise<boolean> => {
+    const request = ++generation.current;
+    setLoading(true);
+    setError(null);
+    try {
+      const result = await libraryApi.getPaper({ requestId: crypto.randomUUID(), paperId });
+      if (!mounted.current || request !== generation.current) return false;
+      if (!result.ok) {
+        setError(result.error.message);
+        setLoading(false);
+        return false;
+      }
+      setPaper(result.data);
+      paperRef.current = result.data;
+      if (!result.data.processingInitialized) {
+        setPhaseCode(null);
+        setError("El procesamiento de este paper todavía no está disponible.");
+      } else if (!result.data.activePhaseCode) {
+        setPhaseCode(null);
+        setError("No hay una fase activa registrada. Comprueba de nuevo el estado.");
+      } else {
+        setPhaseCode((current) => current ?? result.data.activePhaseCode);
+        setError(null);
+      }
+      setLoading(false);
+      return true;
+    } catch {
+      if (!mounted.current || request !== generation.current) return false;
+      setError("No se pudo cargar el paper. Puedes intentarlo de nuevo.");
+      setLoading(false);
+      return false;
+    }
+  }, [libraryApi, paperId]);
+
+  const loadPhase = useCallback(async (requestedCode: PhaseCode): Promise<boolean> => {
+    const request = ++generation.current;
+    setLoading(true);
+    setError(null);
+    setGate(null);
+    setPhase(null);
+    setActivePhase(null);
+    setAnswers([]);
+    setDefinition(null);
+    try {
+      const phaseResult = await api.getPhase({ requestId: crypto.randomUUID(), paperId, phaseCode: requestedCode });
+      const answersResult = await api.getPhaseAnswers({ requestId: crypto.randomUUID(), paperId, phaseCode: requestedCode });
+      if (!mounted.current || request !== generation.current || !phaseResult.ok || !answersResult.ok) {
+        if (mounted.current && request === generation.current) {
+          setError(!phaseResult.ok ? phaseResult.error.message : !answersResult.ok ? answersResult.error.message : null);
+          setLoading(false);
+        }
+        return false;
+      }
+      const definitionResult = await api.getPhaseDefinition({
+        requestId: crypto.randomUUID(),
+        phaseCode: requestedCode,
+        version: phaseResult.data.definitionVersion,
+      });
+      if (!mounted.current || request !== generation.current) return false;
+      if (!definitionResult.ok) {
+        setError(definitionResult.error.message);
+        setLoading(false);
+        return false;
+      }
+      setPhase(phaseResult.data);
+      const currentActiveCode = paperRef.current?.activePhaseCode;
+      if (currentActiveCode === requestedCode) setActivePhase(phaseResult.data);
+      else if (currentActiveCode) {
+        const activeResult = await api.getPhase({ requestId: crypto.randomUUID(), paperId, phaseCode: currentActiveCode });
+        if (!mounted.current || request !== generation.current) return false;
+        if (!activeResult.ok) {
+          setError(activeResult.error.message);
+          setLoading(false);
+          return false;
+        }
+        setActivePhase(activeResult.data);
+      }
+      setAnswers(answersResult.data);
+      setDefinition(definitionResult.data);
+      const drafts = state.drafts;
+      for (const output of definitionResult.data.requiredOutputs) {
+        const key = draftId(requestedCode, output.key);
+        const saved = answersResult.data.find((item) => item.questionKey === output.key);
+        const existing = drafts.get(key);
+        const version = Math.max(state.editSequences.get(key) ?? 0, existing?.editVersion ?? 0);
+        if (!existing) drafts.set(key, fromAnswer(saved, version));
+        else if (existing.status === "saved" || existing.status === "empty") drafts.set(key, fromAnswer(saved, version));
+      }
+      setError(null);
+      setLoading(false);
+      bump();
+      return true;
+    } catch {
+      if (!mounted.current || request !== generation.current) return false;
+      setError("No se pudieron cargar las respuestas. Puedes intentarlo de nuevo.");
+      setLoading(false);
+      return false;
+    }
+  }, [api, bump, paperId, state]);
+
+  const reload = useCallback(async (preferActive = false): Promise<boolean> => {
+    const refreshVersion = state.refreshVersion;
+    if (!await loadPaper()) return false;
+    if (!paperRef.current?.processingInitialized || !paperRef.current.activePhaseCode) return false;
+    const target = preferActive ? paperRef.current.activePhaseCode : selectedPhaseRef.current ?? paperRef.current.activePhaseCode;
+    if (!target || !await loadPhase(target)) return false;
+    if (preferActive) setPhaseCode(target);
+    if (refreshVersion === state.refreshVersion) state.refreshRequired = false;
+    bump();
+    return true;
+  }, [bump, loadPaper, loadPhase, state]);
+
+  useEffect(() => {
+    const listener = (confirmed: boolean, source: symbol) => {
+      if (mounted.current) setChanged((value) => value + 1);
+      if (confirmed && source !== consumerId.current && mounted.current) void reload();
+    };
+    state.listeners.add(listener);
+    return () => { state.listeners.delete(listener); };
+  }, [reload, state]);
+
+  useEffect(() => {
+    mounted.current = true;
+    void reload(true);
+    return () => {
+      mounted.current = false;
+      generation.current++;
+    };
+  }, [reload]);
+
+  const draft = useCallback((code: PhaseCode, key: string, fallback?: PhaseAnswerDto) => {
+    const id = draftId(code, key);
+    let value = state.drafts.get(id);
+    if (!value) {
+      value = fromAnswer(fallback, state.editSequences.get(id) ?? 0);
+      state.drafts.set(id, value);
+    }
+    return value;
+  }, [changed, state]);
+
+  const edit = useCallback((code: PhaseCode, key: string, patch: Partial<Pick<WorkflowDraft, "answerText" | "structuredValue" | "resolution" | "explanation">>) => {
+    contentGeneration.current++;
+    const current = draft(code, key, answers.find((item) => item.questionKey === key));
+    const id = draftId(code, key);
+    const editVersion = Math.max(current.editVersion, state.editSequences.get(id) ?? 0) + 1;
+    state.editSequences.set(id, editVersion);
+    state.drafts.set(id, {
+      ...current,
+      ...patch,
+      editVersion,
+      status: "dirty",
+      error: null,
+    });
+    setGate(null);
+    setMessage(null);
+    bump();
+  }, [answers, bump, draft, state]);
+
+  const save = useCallback(async (code: PhaseCode, key: string, retry = false) => {
+    if (!writable || !activePaper) return;
+    if (state.refreshRequired) return;
+    if (state.busy || state.pendingAction || (state.pending && !retry)) return;
+    let pending = retry ? state.pending : null;
+    if (retry && !pending) return;
+    if (!pending && (activePaper.lifecycle === "ARCHIVED" || activePaper.lifecycle === "COMPLETED")) return;
+    if (!pending) {
+      const current = draft(code, key, answers.find((item) => item.questionKey === key));
+      const args = {
+        requestId: crypto.randomUUID(), paperId, phaseCode: code, questionKey: key,
+        expectedRevision: current.revision,
+        answerText: current.answerText,
+        structuredValue: current.structuredValue,
+        resolution: current.resolution,
+        explanation: current.explanation.trim() || null,
+      } as const;
+      pending = { kind: "save", args, key, phaseCode: code, editVersion: current.editVersion };
+      state.pending = pending;
+    }
+    state.busy = true;
+    const id = draftId(pending.phaseCode, pending.key);
+    const current = state.drafts.get(id);
+    if (current) state.drafts.set(id, { ...current, status: "saving", error: null });
+    bump();
+    try {
+      const result = await api.savePhaseAnswer(pending.args);
+      if (!result.ok) {
+        const latest = state.drafts.get(id);
+        const conflict = result.error.code === "Conflict";
+        if (latest) state.drafts.set(id, { ...latest, status: conflict ? "conflict" : "error", error: result.error.message });
+        state.pending = result.error.retryable ? pending : null;
+        setMessage(result.error.message);
+      } else {
+        const latest = state.drafts.get(id);
+        if (latest) {
+          const saved = fromAnswer(result.data, latest.editVersion);
+          state.drafts.set(id, latest.editVersion === pending.editVersion
+            ? saved
+            : { ...latest, baseline: result.data, revision: result.data.revision, status: "dirty", error: null });
+        }
+        state.pending = null;
+        setAnswers((currentAnswers) => [
+          ...currentAnswers.filter((item) => item.questionKey !== pending.key), result.data,
+        ]);
+        setMessage("Respuesta guardada.");
+        requireRefresh(state);
+        bump(true);
+        const refreshed = await reload();
+        if (refreshed) {
+          setMessage("Respuesta guardada.");
+        } else {
+          setMessage("La respuesta se guardó, pero no se pudo actualizar la vista. No repitas el guardado.");
+        }
+      }
+    } catch {
+      const latest = state.drafts.get(id);
+      if (latest) state.drafts.set(id, { ...latest, status: "unknown", error: "No se confirmó el resultado del guardado." });
+      state.pending = pending;
+      setMessage("No se confirmó el resultado. Reintenta esta misma operación antes de guardar otra respuesta.");
+    } finally {
+      state.busy = false;
+      bump();
+    }
+  }, [activePaper, answers, api, bump, draft, paperId, reload, state, writable]);
+
+  const evaluate = useCallback(async () => {
+    if (!selectedPhase || !phase || state.busy || state.pending || state.pendingAction || state.refreshRequired || hasUnresolvedDrafts(state)) return;
+    const request = generation.current;
+    const contentRequest = contentGeneration.current;
+    setGate(null);
+    setGateRejected(false);
+    setMessage(null);
+    state.busy = true;
+    bump();
+    try {
+      const result = await api.evaluateGate({ requestId: crypto.randomUUID(), paperId, phaseCode: selectedPhase });
+      if (request === generation.current && contentRequest === contentGeneration.current && selectedPhase === phaseCode) {
+        if (result.ok) setGate(result.data);
+        else setMessage(result.error.message);
+      }
+    } catch {
+      if (request === generation.current && contentRequest === contentGeneration.current && selectedPhase === phaseCode) setMessage("No se pudo evaluar la fase. Puedes volver a intentarlo.");
+    } finally {
+      state.busy = false;
+      bump();
+    }
+  }, [api, bump, paperId, phase, phaseCode, selectedPhase, state]);
+
+  const runAction = useCallback(async (action: PendingAction) => {
+    if (state.busy || state.pending || state.refreshRequired || (state.pendingAction && state.pendingAction !== action)) return;
+    state.busy = true;
+    setMessage(null);
+    bump();
+    try {
+      if (action.kind === "back") {
+        const result = await api.goBackToPhase(action.args);
+        if (!result.ok) {
+          setMessage(result.error.message);
+          state.pendingAction = result.error.retryable ? action : null;
+        } else {
+          state.pendingAction = null;
+          setMessage("La transición se confirmó. Actualizando el estado actual del paper…");
+          requireRefresh(state);
+          bump(true);
+          if (!await reload(true)) setMessage("El contexto se actualizó, pero no se pudo actualizar la vista. Reintenta la carga; no repitas la transición.");
+          else setMessage("Contexto de trabajo actualizado.");
+        }
+      } else if (action.kind === "touch") {
+        const result = await api.touchPhase(action.args);
+        if (!result.ok) {
+          setMessage(result.error.message);
+          state.pendingAction = result.error.retryable ? action : null;
+        } else {
+          state.pendingAction = null;
+          setMessage("La transición se confirmó. Actualizando el estado actual del paper…");
+          requireRefresh(state);
+          bump(true);
+          if (!await reload(true)) setMessage("La fase se activó, pero no se pudo actualizar la vista. Reintenta la carga; no repitas la transición.");
+          else setMessage("Fase activada.");
+        }
+      } else {
+        const result = await api.advancePhase(action.args);
+        if (!result.ok) {
+          setMessage(result.error.message);
+          state.pendingAction = result.error.code === "GateBlocked" ? null : result.error.retryable ? action : null;
+          const gateBlocked = result.error.code === "GateBlocked";
+          if (gateBlocked) setGate(null);
+          setGateRejected(gateBlocked);
+        } else {
+          state.pendingAction = null;
+          setGate(null);
+          setMessage("La transición se confirmó. Actualizando el estado actual del paper…");
+          requireRefresh(state);
+          bump(true);
+          const refreshed = await reload(true);
+          if (!refreshed) setMessage("La transición se confirmó, pero no se pudo actualizar la vista. Reintenta la carga; no repitas la transición.");
+          else setMessage(paperRef.current?.lifecycle === "ARCHIVED" ? "Paper archivado." : paperRef.current?.activePhaseCode === "P2" ? "P1 completada. P2 está disponible para consulta; su edición llegará en una fase posterior." : "Fase completada.");
+        }
+      }
+    } catch {
+      state.pendingAction = action;
+      setMessage("No se confirmó el resultado. Reintenta esta misma operación para resolverlo antes de otra mutación.");
+    } finally {
+      state.busy = false;
+      bump();
+    }
+  }, [api, bump, paperId, reload, state]);
+
+  const transition = useCallback(async (target: PhaseCode, direction: "back" | "forward") => {
+    if (!activePaper?.activePhaseCode || !activePhase || state.busy || state.pending || state.pendingAction || state.refreshRequired || hasUnresolvedDrafts(state)) return;
+    const action: PendingAction = direction === "back"
+      ? { kind: "back", target, args: { requestId: crypto.randomUUID(), paperId, targetPhase: target, expectedActivePhaseRevision: activePhase.revision } }
+      : { kind: "touch", target, args: { requestId: crypto.randomUUID(), paperId, phaseCode: target, expectedActivePhaseRevision: activePhase.revision } };
+    await runAction(action);
+  }, [activePaper, activePhase, paperId, runAction, selectedPhase, state]);
+
+  const advance = useCallback(async () => {
+    if (!activePaper?.activePhaseCode || !phase || !selectedPhase || selectedPhase !== activePaper.activePhaseCode || state.busy || state.pending || state.pendingAction || state.refreshRequired || hasUnresolvedDrafts(state)) return;
+    await runAction({ kind: "advance", args: { requestId: crypto.randomUUID(), paperId, fromPhase: activePaper.activePhaseCode, expectedPhaseRevision: phase.revision } });
+  }, [activePaper, paperId, phase, runAction, selectedPhase, state]);
+
+  const retryAction = useCallback(() => state.pendingAction ? runAction(state.pendingAction) : undefined, [runAction, state]);
+
+  const selectPhase = useCallback((code: PhaseCode) => {
+    generation.current++;
+    setPhaseCode(code);
+    setError(null);
+    void loadPhase(code);
+  }, [loadPhase]);
+
+  const discardDraft = useCallback((code: PhaseCode, key: string) => {
+    const saved = answers.find((item) => item.questionKey === key);
+    const id = draftId(code, key);
+    const current = state.drafts.get(id);
+    state.drafts.set(id, fromAnswer(saved, Math.max(current?.editVersion ?? 0, state.editSequences.get(id) ?? 0)));
+    bump();
+  }, [answers, bump, state]);
+
+  const reviewConflict = useCallback(async (code: PhaseCode, key: string) => {
+    const request = ++generation.current;
+    try {
+      const [paperResult, phaseResult, result] = await Promise.all([
+        libraryApi.getPaper({ requestId: crypto.randomUUID(), paperId }),
+        api.getPhase({ requestId: crypto.randomUUID(), paperId, phaseCode: code }),
+        api.getPhaseAnswers({ requestId: crypto.randomUUID(), paperId, phaseCode: code }),
+      ]);
+      if (request !== generation.current || selectedPhase !== code) return;
+      if (!paperResult.ok) { setMessage(paperResult.error.message); return; }
+      if (!phaseResult.ok) { setMessage(phaseResult.error.message); return; }
+      if (!result.ok) {
+        setMessage(result.error.message);
+        return;
+      }
+      const definitionResult = await api.getPhaseDefinition({
+        requestId: crypto.randomUUID(), phaseCode: code, version: phaseResult.data.definitionVersion,
+      });
+      if (request !== generation.current || selectedPhase !== code) return;
+      if (!definitionResult.ok) { setMessage(definitionResult.error.message); return; }
+      const activeResult = paperResult.data.activePhaseCode === code ? phaseResult : paperResult.data.activePhaseCode
+        ? await api.getPhase({ requestId: crypto.randomUUID(), paperId, phaseCode: paperResult.data.activePhaseCode })
+        : null;
+      if (request !== generation.current || selectedPhase !== code) return;
+      paperRef.current = paperResult.data;
+      setPaper(paperResult.data);
+      setPhase(phaseResult.data);
+      setActivePhase(activeResult?.ok ? activeResult.data : null);
+      setDefinition(definitionResult.data);
+      setAnswers(result.data);
+      const current = state.drafts.get(draftId(code, key));
+      if (!current) return;
+      const observed = result.data.find((item) => item.questionKey === key) ?? null;
+      state.drafts.set(draftId(code, key), { ...current, observed, conflictReviewed: true });
+      setMessage("Versión guardada cargada. Elige qué versión conservar.");
+      bump();
+    } catch {
+      if (request === generation.current && selectedPhase === code) {
+        setMessage("No se pudo leer la versión guardada. El borrador local se conserva.");
+      }
+    }
+  }, [api, bump, libraryApi, paperId, selectedPhase, state]);
+
+  const useSavedConflict = useCallback((code: PhaseCode, key: string) => {
+    const current = state.drafts.get(draftId(code, key));
+    if (!current || !current.conflictReviewed) return;
+    const saved = current.observed ?? undefined;
+    const id = draftId(code, key);
+    const version = Math.max(current.editVersion, state.editSequences.get(id) ?? 0) + 1;
+    state.editSequences.set(id, version);
+    state.drafts.set(id, fromAnswer(saved, version));
+    setAnswers((currentAnswers) => [
+      ...currentAnswers.filter((item) => item.questionKey !== key),
+      ...(saved ? [saved] : []),
+    ]);
+    setMessage("Se está usando la versión guardada.");
+    bump();
+  }, [bump, state]);
+
+  const reapplyConflict = useCallback((code: PhaseCode, key: string) => {
+    const current = state.drafts.get(draftId(code, key));
+    if (!current || !current.conflictReviewed) return;
+    const id = draftId(code, key);
+    const version = Math.max(current.editVersion, state.editSequences.get(id) ?? 0) + 1;
+    state.editSequences.set(id, version);
+    state.drafts.set(draftId(code, key), {
+      ...current,
+      baseline: current.observed,
+      revision: current.observed?.revision ?? 0,
+      observed: null,
+      conflictReviewed: false,
+      status: "dirty",
+      error: null,
+      editVersion: version,
+    });
+    setMessage("Borrador conservado. Guardar creará una operación nueva sobre la revisión observada.");
+    bump();
+  }, [bump, state]);
+
+  const fields = useMemo(() => definition?.requiredOutputs.map((output) => ({
+    output,
+    draft: draft(output.key ? selectedPhase ?? "PRE" : "PRE", output.key, answers.find((item) => item.questionKey === output.key)),
+  })) ?? [], [answers, definition, draft, selectedPhase]);
+
+  return {
+    paper: activePaper, phaseCode: selectedPhase, phase, activePhase, answers, definition, gate, loading, error, message,
+    busy: state.busy, pending: state.pending, pendingAction: state.pendingAction, fields,
+    refreshRequired: state.refreshRequired,
+    hasDirty: hasUnresolvedDrafts(state),
+    gateRejected,
+    selectPhase, loadPaper, loadPhase, reload, edit, save,
+    retry: () => state.pending ? save(state.pending.phaseCode, state.pending.key, true) : undefined,
+    retryAction, evaluate, transition, advance, discardDraft, reviewConflict, useSavedConflict, reapplyConflict,
+  };
+}
+
+function hasUnresolvedDrafts(state: PaperSession): boolean {
+  for (const value of state.drafts.values()) {
+    if (value.status === "dirty" || value.status === "saving" || value.status === "error" || value.status === "unknown" || value.status === "conflict") return true;
+  }
+  return false;
+}
+
+function requireRefresh(state: PaperSession): void {
+  state.refreshVersion += 1;
+  state.refreshRequired = true;
+}
