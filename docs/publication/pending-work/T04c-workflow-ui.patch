+.workflow-context-action {
+  margin: 18px 0;
+  padding: 16px 18px;
+  border: 1px solid var(--line);
+  border-left: 4px solid var(--accent);
+  border-radius: 10px;
+  background: var(--surface-soft);
+}
+.workflow-definition {
+  margin: 20px 0;
+}
+.workflow-definition ul,
+.workflow-gate ul {
+  padding-left: 23px;
+}
+.workflow-definition li,
+.workflow-gate li {
+  margin: 6px 0;
+}
+.workflow-definition summary {
+  cursor: pointer;
+  font-weight: 650;
+}
+.workflow-answers {
+  display: grid;
+  gap: 16px;
+  margin: 22px 0;
+}
+.workflow-answer {
+  min-width: 0;
+  margin: 0;
+  padding: 20px;
+  border: 1px solid var(--line);
+  border-radius: 12px;
+  background: var(--surface);
+}
+.workflow-answer legend {
+  padding: 0 6px;
+  font-weight: 700;
+  color: #244750;
+}
+.workflow-answer label,
+.workflow-decision label,
+.workflow-special-choice label {
+  display: grid;
+  gap: 7px;
+  margin: 13px 0;
+  color: #3c565d;
+  font-size: 13px;
+  font-weight: 650;
+}
+.workflow-answer textarea,
+.workflow-answer select,
+.workflow-decision select,
+.workflow-special-choice select {
+  width: 100%;
+  min-height: 42px;
+  border: 1px solid #bfcfce;
+  border-radius: 8px;
+  padding: 9px 11px;
+  color: #203b43;
+  background: #fff;
+  font: inherit;
+}
+.workflow-answer textarea {
+  resize: vertical;
+  line-height: 1.5;
+}
+.workflow-decision {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 14px;
+}
+.workflow-answer-actions {
+  margin-top: 14px;
+  padding-top: 12px;
+  border-top: 1px solid var(--line);
+}
+.workflow-answer-actions > span:first-child {
+  font-weight: 700;
+}
+.workflow-answer-actions > span:nth-child(2) {
+  flex-basis: 100%;
+  color: var(--muted);
+  font-size: 13px;
+}
+.workflow-gate {
+  margin-top: 20px;
+  padding: 20px;
+  border: 1px solid var(--line);
+  border-radius: 12px;
+  background: var(--surface);
+}
+.workflow-gate small {
+  color: var(--muted);
+}
+.workflow-gate a {
+  color: var(--accent-dark);
+  text-decoration-thickness: 1px;
+  text-underline-offset: 3px;
+}
+.workflow-answer[aria-invalid="true"] {
+  border-color: var(--danger);
+}
