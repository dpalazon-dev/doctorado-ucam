@@ -0,0 +1,21 @@
+import type { GateEvaluationDto } from "../../shared/contracts/generated/contracts";
+
+export function GateIssues({ gate, onFocusField }: { gate: GateEvaluationDto; onFocusField?: (key: string) => void }) {
+  if (gate.complete) return <section className="workflow-gate" role="status"><h2>Revisión preliminar completa</h2><p>La evaluación está lista; la fase sólo se completa con la acción explícita de avance.</p></section>;
+  return (
+    <section className="workflow-gate" aria-labelledby="workflow-gate-title">
+      <h2 id="workflow-gate-title">Elementos pendientes de la evaluación</h2>
+      {gate.issues.length ? (
+        <ul>
+          {gate.issues.map((issue, index) => {
+            const fieldId = `workflow-field-${gate.phaseCode}-${issue.requirementKey}`;
+            return <li key={`${issue.requirementKey}-${index}`}>
+              {document.getElementById(fieldId) ? <a href={`#${fieldId}`} onClick={() => onFocusField?.(issue.requirementKey)}>{issue.message}</a> : <span>{issue.message}</span>}
+              <small> {issue.status}</small>
+            </li>;
+          })}
+        </ul>
+      ) : <p>El servidor indica que aún faltan requisitos; vuelve a evaluar para ver el detalle.</p>}
+    </section>
+  );
+}
diff --git a/src/features/workflow/PhaseAnswerForm.tsx b/src/features/workflow/PhaseAnswerForm.tsx
new file mode 100644
index 0000000..d64a181
--- /dev/null
+++ b/src/features/workflow/PhaseAnswerForm.tsx
@@ -0,0 +1,213 @@
+import type {
+  AnswerResolution,
+  JsonValue,
+  PaperDto,
+  PhaseCode,
+  PhaseRequiredOutputDto,
+  RelevanceRating,
+  ReadingDecision,
+} from "../../shared/contracts/generated/contracts";
+import type { WorkflowDraft } from "./useWorkflow";
+
+const relevanceOptions: RelevanceRating[] = ["sufficient", "use_with_caution", "weak_for_my_purpose"];
+const decisionOptions: ReadingDecision[] = ["continue", "light_read", "archive"];
+const resolutionLabels: Record<AnswerResolution, string> = {
+  PENDING: "Pendiente",
+  ANSWERED: "Respondida",
+  UNKNOWN: "Desconocida",
+  NOT_APPLICABLE: "No aplicable",
+};
+
+function fieldId(code: PhaseCode, key: string) {
+  return `workflow-field-${code}-${key}`;
+}
+
+export function PhaseAnswerForm({
+  phaseCode,
+  output,
+  draft,
+  reviewType,
+  writable,
+  busy,
+  mutationPending,
+  onEdit,
+  onSave,
+  onDiscard,
+  onReviewConflict,
+  onUseSaved,
+  onReapply,
+}: {
+  phaseCode: PhaseCode;
+  output: PhaseRequiredOutputDto;
+  draft: WorkflowDraft;
+  reviewType: PaperDto["reviewType"];
+  writable: boolean;
+  busy: boolean;
+  mutationPending: boolean;
+  onEdit: (patch: Partial<Pick<WorkflowDraft, "answerText" | "structuredValue" | "resolution" | "explanation">>) => void;
+  onSave: () => void;
+  onDiscard: () => void;
+  onReviewConflict: () => void;
+  onUseSaved: () => void;
+  onReapply: () => void;
+}) {
+  const id = fieldId(phaseCode, output.key);
+  const readOnly = !writable || draft.status === "conflict";
+  const value = draft.structuredValue && typeof draft.structuredValue === "object" && !Array.isArray(draft.structuredValue)
+    ? draft.structuredValue as Record<string, JsonValue>
+    : {};
+  const isReviewType = phaseCode === "PRE" && output.key === "review_type";
+  const isDecision = phaseCode === "P1" && output.key === "relevance_decision";
+  const decisionIncomplete = isDecision && draft.resolution === "ANSWERED"
+    && (!relevanceOptions.includes(value.relevance as RelevanceRating) || !decisionOptions.includes(value.readingDecision as ReadingDecision));
+  const decisionPartial = isDecision && draft.structuredValue !== null
+    && !(relevanceOptions.includes(value.relevance as RelevanceRating) && decisionOptions.includes(value.readingDecision as ReadingDecision));
+  const needsExplanation = draft.resolution === "UNKNOWN" || draft.resolution === "NOT_APPLICABLE";
+  const canSave = !readOnly && !busy && !mutationPending && draft.status !== "saved" && draft.status !== "saving" && !decisionIncomplete && !decisionPartial
+    && (!needsExplanation || Boolean(draft.explanation.trim()));
+
+  return (
+    <fieldset className="workflow-answer" id={id} aria-describedby={draft.error ? `${id}-error` : undefined} aria-invalid={Boolean(draft.error)}>
+      <legend>{output.label}{output.required ? " · requerida" : " · opcional"}</legend>
+      <p>{output.prompt}</p>
+      {isReviewType ? (
+        <div className="workflow-special-choice">
+          <p>Tipo bibliográfico registrado: <strong>{reviewType}</strong></p>
+          {(draft.resolution === "ANSWERED" || draft.resolution === "UNKNOWN") && value.reviewType !== reviewType && <p role="alert">La respuesta guardada confirma otro tipo. Vuelve a confirmar el metadato actual.</p>}
+          {reviewType === "unknown" ? (
+            <label>
+              Confirmación
+              <select
+                aria-label="Resolución del tipo bibliográfico"
+                value={draft.resolution}
+                disabled={readOnly}
+                onChange={(event) => onEdit({
+                  resolution: event.target.value as AnswerResolution,
+                  structuredValue: event.target.value === "UNKNOWN" ? { reviewType: "unknown" } : null,
+                  answerText: "",
+                })}
+              >
+                <option value="PENDING">Pendiente</option>
+                <option value="UNKNOWN">Desconocido</option>
+              </select>
+            </label>
+          ) : (
+            <button
+              type="button"
+              disabled={readOnly}
+              aria-pressed={draft.resolution === "ANSWERED" && value.reviewType === reviewType}
+              onClick={() => onEdit({ resolution: "ANSWERED", structuredValue: { reviewType }, answerText: "", explanation: "" })}
+            >
+              Confirmar {reviewType}
+            </button>
+          )}
+        </div>
+      ) : isDecision ? (
+        <div className="workflow-decision">
+          <label>
+            Relevancia para mi propósito
+            <select
+              value={typeof value.relevance === "string" ? value.relevance : ""}
+              disabled={readOnly}
+              onChange={(event) => {
+                const next = { ...value };
+                if (event.target.value) next.relevance = event.target.value;
+                else delete next.relevance;
+                const complete = relevanceOptions.includes(next.relevance as RelevanceRating) && decisionOptions.includes(next.readingDecision as ReadingDecision);
+                onEdit({ structuredValue: Object.keys(next).length ? next as JsonValue : null, resolution: complete ? "ANSWERED" : "PENDING" });
+              }}
+            >
+              <option value="">Elige una valoración</option>
+              {relevanceOptions.map((option) => <option key={option} value={option}>{option}</option>)}
+            </select>
+          </label>
+          <label>
+            Decisión de lectura
+            <select
+              value={typeof value.readingDecision === "string" ? value.readingDecision : ""}
+              disabled={readOnly}
+              onChange={(event) => {
+                const next = { ...value };
+                if (event.target.value) next.readingDecision = event.target.value;
+                else delete next.readingDecision;
+                const complete = relevanceOptions.includes(next.relevance as RelevanceRating) && decisionOptions.includes(next.readingDecision as ReadingDecision);
+                onEdit({ structuredValue: Object.keys(next).length ? next as JsonValue : null, resolution: complete ? "ANSWERED" : "PENDING" });
+              }}
+            >
+              <option value="">Elige una decisión</option>
+              {decisionOptions.map((option) => <option key={option} value={option}>{option === "archive" ? "Archivar" : option === "light_read" ? "Lectura ligera" : "Continuar"}</option>)}
+            </select>
+          </label>
+          {decisionIncomplete && <p role="status">Completa ambas elecciones antes de guardar la respuesta.</p>}
+          {decisionPartial && <p role="status">El borrador conserva tu elección parcial. El objeto estructurado sólo se enviará cuando completes ambas opciones.</p>}
+        </div>
+      ) : (
+        <label htmlFor={`${id}-answer`}>
+          Respuesta
+          <textarea
+            id={`${id}-answer`}
+            value={draft.answerText}
+            disabled={readOnly}
+            rows={4}
+            onChange={(event) => onEdit({ answerText: event.target.value })}
+          />
+        </label>
+      )}
+      {!isReviewType && !isDecision && (
+        <label htmlFor={`${id}-resolution`}>
+          Resolución
+          <select
+            id={`${id}-resolution`}
+            value={draft.resolution}
+            disabled={readOnly}
+            onChange={(event) => onEdit({ resolution: event.target.value as AnswerResolution })}
+          >
+            {output.allowedResolutions.map((resolution) => <option key={resolution} value={resolution}>{resolutionLabels[resolution]}</option>)}
+          </select>
+        </label>
+      )}
+      {needsExplanation && (
+        <label htmlFor={`${id}-explanation`}>
+          Explicación necesaria
+          <textarea
+            id={`${id}-explanation`}
+            value={draft.explanation}
+            disabled={readOnly}
+            rows={3}
+            onChange={(event) => onEdit({ explanation: event.target.value })}
+          />
+        </label>
+      )}
+      {draft.error && <p id={`${id}-error`} role="alert">{draft.error}</p>}
+      {draft.status === "conflict" && (
+        <div className="workflow-conflict" aria-live="polite">
+          {!draft.conflictReviewed ? (
+            <button type="button" disabled={busy} onClick={onReviewConflict}>Revisar versión guardada</button>
+          ) : (
+            <>
+              <p>Compara la versión local con la que está guardada actualmente y elige qué versión conservar.</p>
+              <dl className="workflow-conflict-values">
+                <dt>Texto guardado</dt><dd>{draft.observed?.answerText || "(vacío)"}</dd>
+                <dt>Valor estructurado guardado</dt><dd>{draft.observed?.structuredValue === null || draft.observed?.structuredValue === undefined ? "(vacío)" : JSON.stringify(draft.observed.structuredValue)}</dd>
+                <dt>Resolución guardada</dt><dd>{draft.observed?.resolution ?? "Sin respuesta guardada"}</dd>
+                <dt>Explicación guardada</dt><dd>{draft.observed?.explanation || "(vacía)"}</dd>
+                <dt>Texto de mi borrador</dt><dd>{draft.answerText || "(vacío)"}</dd>
+                <dt>Valor estructurado de mi borrador</dt><dd>{draft.structuredValue === null ? "(vacío)" : JSON.stringify(draft.structuredValue)}</dd>
+                <dt>Resolución de mi borrador</dt><dd>{draft.resolution}</dd>
+                <dt>Explicación de mi borrador</dt><dd>{draft.explanation || "(vacía)"}</dd>
+              </dl>
+              <button type="button" disabled={busy} onClick={onUseSaved}>Usar versión guardada</button>
+              <button type="button" disabled={busy} onClick={onReapply}>Conservar mi borrador</button>
+            </>
+          )}
+        </div>
+      )}
+      <div className="workflow-answer-actions">
+        <span role="status">{draft.status === "saving" ? "Guardando…" : draft.status === "saved" ? draft.resolution === "PENDING" ? "Guardado · pendiente" : "Guardado" : draft.status === "empty" ? "Sin respuesta guardada" : draft.status === "conflict" ? "Conflicto" : draft.status === "unknown" ? "Resultado sin confirmar" : draft.status === "error" ? "No guardado" : "Borrador sin guardar"}</span>
+        {draft.status === "dirty" && <span>Este borrador sólo se conserva mientras la aplicación esté abierta.</span>}
+        <button type="button" disabled={!canSave} onClick={onSave}>Guardar respuesta</button>
+        {(draft.status === "dirty" || draft.status === "error" || draft.status === "unknown") && <button type="button" disabled={busy} onClick={onDiscard}>Descartar cambios</button>}
+      </div>
+    </fieldset>
+  );
+}
diff --git a/src/features/workflow/PhaseWorkspace.tsx b/src/features/workflow/PhaseWorkspace.tsx
new file mode 100644
index 0000000..cda5064
--- /dev/null
+++ b/src/features/workflow/PhaseWorkspace.tsx
@@ -0,0 +1,175 @@
+import type { LibraryApi, WorkflowApi } from "../../shared/contracts/ports";
+import type { PhaseCode } from "../../shared/contracts/generated/contracts";
+import { GateIssues } from "./GateIssues";
+import { PhaseAnswerForm } from "./PhaseAnswerForm";
+import { useWorkflow, type WorkflowSession } from "./useWorkflow";
+
+export type PhaseWorkspaceProps = {
+  paperId: string;
+  api: WorkflowApi;
+  libraryApi: Pick<LibraryApi, "getPaper">;
+  session: WorkflowSession;
+  writable: boolean;
+  onClose: () => void;
+};
+
+const phases: PhaseCode[] = ["PRE", "P1", "P2"];
+
+export function PhaseWorkspace({ paperId, api, libraryApi, session, writable, onClose }: PhaseWorkspaceProps) {
+  const workflow = useWorkflow({ api, libraryApi, paperId, session, writable });
+  const { paper, phaseCode, phase, activePhase, definition } = workflow;
+  const archived = paper?.lifecycle === "ARCHIVED";
+  const reserved = paper?.lifecycle === "COMPLETED";
+  const p2 = phaseCode === "P2";
+  const mutable = Boolean(writable && !archived && !reserved && !p2 && phaseCode && phase && phase.state !== "NOT_STARTED" && definition);
+  const outputs = workflow.fields;
+  const p1Decision = outputs.find(({ output }) => output.key === "relevance_decision")?.draft;
+  const p1Branch = p1Decision?.structuredValue && typeof p1Decision.structuredValue === "object" && !Array.isArray(p1Decision.structuredValue)
+    ? p1Decision.structuredValue.readingDecision
+    : null;
+  const mutationPending = Boolean(workflow.pending || workflow.pendingAction || workflow.refreshRequired);
+  const canAdvance = Boolean(mutable && activePhase?.code === phaseCode && (phase?.state === "IN_PROGRESS" || phase?.state === "NEEDS_REVIEW")
+    && workflow.gate?.complete && !workflow.hasDirty && !workflow.busy && !mutationPending);
+
+  return (
+    <section className="workflow-workspace" aria-labelledby="workflow-title">
+      <div className="workflow-toolbar">
+        <button type="button" onClick={onClose}>Volver a Biblioteca</button>
+        <span>Procesamiento del paper</span>
+      </div>
+      {workflow.loading && <p role="status">Cargando el estado del procesamiento…</p>}
+      {workflow.error && (
+        <div role="alert">
+          <p>{workflow.error}</p>
+          <button type="button" disabled={workflow.loading || workflow.busy} onClick={() => void workflow.reload()}>Reintentar carga</button>
+        </div>
+      )}
+      {workflow.refreshRequired && !workflow.error && (
+        <div role="alert">
+          <p>La operación se confirmó, pero falta actualizar el estado actual. No repitas la operación.</p>
+          <button type="button" disabled={workflow.loading || workflow.busy} onClick={() => void workflow.reload()}>Reintentar carga</button>
+        </div>
+      )}
+      {paper && (
+        <>
+          <header className="workflow-heading">
+            <div>
+              <p className="eyebrow">{paper.lifecycle === "ARCHIVED" ? "Archivado · solo lectura" : paper.lifecycle === "COMPLETED" ? "Estado reservado · solo lectura" : "Procesamiento local"}</p>
+              <h1 id="workflow-title">{paper.title}</h1>
+              <p>Estado del paper: <strong>{paper.lifecycle}</strong>. El estado del PDF se comprueba al evaluar y no condiciona la consulta ni el borrador local.</p>
+            </div>
+          </header>
+          {!paper.processingInitialized ? (
+            <p role="status">El procesamiento todavía no está inicializado. Esta vista no lo inicializa.</p>
+          ) : !paper.activePhaseCode ? (
+            <p role="alert">No hay una fase activa registrada. No se activará PRE automáticamente.</p>
+          ) : (
+            <>
+              <nav className="workflow-phase-nav" aria-label="Fases de procesamiento">
+                {phases.map((code) => (
+                  <button key={code} type="button" aria-current={phaseCode === code ? "step" : undefined}
+                    disabled={workflow.busy || workflow.loading} onClick={() => workflow.selectPhase(code)}>
+                    {code === paper.activePhaseCode ? `Activa · ${code}` : `Consultar ${code}`}
+                  </button>
+                ))}
+                <button type="button" disabled aria-label="P3 no disponible">P3 · próximamente</button>
+                <button type="button" disabled aria-label="P4 no disponible">P4 · próximamente</button>
+              </nav>
+              {archived && <div className="workflow-notice" role="status"><strong>Paper archivado.</strong> Puedes consultar sus fases y respuestas. Para editar o cambiar el estado, vuelve a Biblioteca y restáuralo expresamente.</div>}
+              {reserved && <div className="workflow-notice" role="status">El estado COMPLETED está reservado. Se permite la consulta; las transiciones Workflow no están disponibles.</div>}
+              {phase?.state === "NOT_STARTED" && <div className="workflow-notice" role="status">Esta fase no se ha iniciado y debe activarse expresamente antes de guardar respuestas o evaluar su gate.</div>}
+              {!writable && !archived && <div className="workflow-notice" role="status">No se ha confirmado que la biblioteca permita escribir. Las respuestas se pueden consultar, pero no guardar ni cambiar de fase.</div>}
+              {paper.activePhaseCode && phaseCode && paper.activePhaseCode !== phaseCode && !archived && !reserved && (
+                <div className="workflow-context-action">
+                  <p>Consulta {phaseCode}. La fase activa de trabajo sigue siendo {paper.activePhaseCode}.</p>
+                  <button type="button" disabled={!activePhase || !writable || workflow.busy || workflow.hasDirty || mutationPending
+                    || (phase?.state === "NOT_STARTED" && phases.indexOf(phaseCode) < phases.indexOf(paper.activePhaseCode))}
+                    onClick={() => void workflow.transition(phaseCode, phases.indexOf(phaseCode) < phases.indexOf(paper.activePhaseCode!) ? "back" : "forward")}>
+                    {phases.indexOf(phaseCode) < phases.indexOf(paper.activePhaseCode)
+                      ? `Volver al contexto ${phaseCode}`
+                      : `Activar ${phaseCode} como fase de trabajo`}
+                  </button>
+                </div>
+              )}
+              {definition && phase && phaseCode && (
+                <>
+                  <p className="workflow-phase-state">Estado de {phaseCode}: <strong>{phase.state === "NEEDS_REVIEW" ? "requiere reconfirmación" : phase.state === "IN_PROGRESS" ? "en curso" : phase.state === "COMPLETED" ? "completada" : "sin iniciar"}</strong>
+                    {phase.completedAt && <> · Última finalización: {new Date(phase.completedAt).toLocaleDateString("es-ES")}</>}
+                  </p>
+                  <article className="workflow-definition card">
+                    <p className="eyebrow">{definition.name} · versión {definition.version}</p>
+                    <h2>{definition.objective}</h2>
+                    <ul>{definition.keyQuestions.map((item) => <li key={item}>{item}</li>)}</ul>
+                    <details>
+                      <summary>Orientaciones de esta fase</summary>
+                      <h3>Consideraciones</h3><ul>{definition.considerations.map((item) => <li key={item}>{item}</li>)}</ul>
+                      <h3>Conviene hacer</h3><ul>{definition.doItems.map((item) => <li key={item}>{item}</li>)}</ul>
+                      <h3>Evita</h3><ul>{definition.dontItems.map((item) => <li key={item}>{item}</li>)}</ul>
+                    </details>
+                  </article>
+                  {p2 ? (
+                    <div className="workflow-notice" role="status">
+                      <h2>P2 · Síntesis y conocimiento</h2>
+                      <p>Esta fase se puede consultar. Guardar respuestas, evaluar su gate y avanzar estarán disponibles en una fase posterior.</p>
+                      <h3>Respuestas existentes</h3>
+                      {outputs.length ? <dl className="workflow-readonly-outputs">{outputs.map(({ output, draft }) => (
+                        <div key={output.key}><dt>{output.label}</dt><dd>{draft.baseline ? <>
+                          <p>{draft.baseline.answerText || "Sin texto de respuesta."}</p>
+                          <p>Resolución: {draft.baseline.resolution}</p>
+                          {draft.baseline.structuredValue !== null && <p>Valor estructurado: {JSON.stringify(draft.baseline.structuredValue)}</p>}
+                          {draft.baseline.explanation && <p>Explicación: {draft.baseline.explanation}</p>}
+                        </> : <p>Sin respuesta guardada.</p>}</dd></div>
+                      ))}</dl> : <p>No hay respuestas guardadas para mostrar.</p>}
+                    </div>
+                  ) : (
+                    <div className="workflow-answers">
+                      <h2>Respuestas de {phaseCode}</h2>
+                      {outputs.map(({ output, draft }) => (
+                        <PhaseAnswerForm key={`${phaseCode}-${output.key}`} phaseCode={phaseCode} output={output} draft={draft}
+                          reviewType={paper.reviewType} writable={mutable} busy={workflow.busy}
+                          mutationPending={mutationPending}
+                          onEdit={(patch) => workflow.edit(phaseCode, output.key, patch)}
+                          onSave={() => void workflow.save(phaseCode, output.key)}
+                          onDiscard={() => workflow.discardDraft(phaseCode, output.key)}
+                          onReviewConflict={() => void workflow.reviewConflict(phaseCode, output.key)}
+                          onUseSaved={() => workflow.useSavedConflict(phaseCode, output.key)}
+                          onReapply={() => workflow.reapplyConflict(phaseCode, output.key)} />
+                      ))}
+                    </div>
+                  )}
+                  {workflow.pending && <div className="workflow-notice" role="alert">
+                    <p>Hay un guardado cuyo resultado no se ha confirmado. Reintenta la misma solicitud para resolverlo antes de otra mutación de este paper.</p>
+                    <button type="button" disabled={workflow.busy || !writable} onClick={() => void workflow.retry()}>Reintentar el mismo guardado</button>
+                  </div>}
+                  {workflow.pendingAction && <div className="workflow-notice" role="alert">
+                    <p>El resultado de la transición no se confirmó. Reintenta con la misma solicitud antes de iniciar otra mutación.</p>
+                    <button type="button" disabled={workflow.busy} onClick={() => void workflow.retryAction()}>Reintentar la misma transición</button>
+                  </div>}
+                  {workflow.message && <p role="status">{workflow.message}</p>}
+                  {workflow.gateRejected && <button type="button" disabled={!mutable || workflow.busy || workflow.hasDirty || mutationPending}
+                    onClick={() => void workflow.evaluate()}>Volver a evaluar fase</button>}
+                  <div className="workflow-gate-actions">
+                    {!archived && !reserved && !p2 && (
+                      <>
+                        <button type="button" disabled={!mutable || workflow.busy || workflow.hasDirty || mutationPending}
+                          onClick={() => void workflow.evaluate()}>Evaluar fase</button>
+                        {phaseCode === "PRE" && <button type="button" className="primary" disabled={!canAdvance}
+                          onClick={() => void workflow.advance()}>Completar PRE y continuar</button>}
+                        {phaseCode === "P1" && <button type="button" className="primary" disabled={!canAdvance}
+                          onClick={() => void workflow.advance()}>
+                          {p1Branch === "archive" ? "Completar P1 y archivar" : p1Branch === "light_read" ? "Completar P1 con lectura ligera" : "Completar P1 y continuar"}
+                        </button>}
+                      </>
+                    )}
+                  </div>
+                  {workflow.gate && workflow.gate.phaseCode === phaseCode && <GateIssues gate={workflow.gate} />}
+                  {workflow.message?.includes("capacidad") && <p role="status">La capacidad de esta operación aún no está disponible.</p>}
+                </>
+              )}
+            </>
+          )}
+        </>
+      )}
+    </section>
+  );
+}
